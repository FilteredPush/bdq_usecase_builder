<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Write log output to stderr so it does not pollute the wizard's stdout -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Application logger: INFO and above -->
    <logger name="org.filteredpush.bdq.usecasebuilder" level="INFO" additivity="false">
        <appender-ref ref="STDERR"/>
    </logger>

    <!-- Suppress verbose Jena / HTTP-client output -->
    <logger name="org.apache.jena" level="WARN"/>
    <logger name="org.apache.http" level="WARN"/>

    <!-- Root: WARN and above -->
    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>

</configuration>
